import streamlit as st
import pandas as pd

class UsuariosView:
    """View responsável pelo gerenciamento e visualização de usuários."""

    def render(self, db):
        st.subheader("👥 Módulo de Usuários")
        st.write("Gerenciamento rápido de cadastros na tabela `ALFA_USUARIO`.")
        try:
            conn = db._conectar()
            df_usuarios = pd.read_sql("SELECT id_usuario, nm_login, ds_email, fl_ativo FROM ALFA_USUARIO", con=conn)
            conn.close()
            st.dataframe(df_usuarios, use_container_width=True)
        except Exception as e:
            st.error(f"Erro ao carregar usuários: {e}")